<?xml version="1.0" encoding="utf-8"?>
<!-- Quadrat (2×2): Cover als Hintergrund, Titel darüber, Play-Taste -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amber_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/amber_widget_bg">

    <ImageView android:id="@+id/amber_cover"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@drawable/amber_widget_bg" android:clipToOutline="true"
        android:scaleType="centerCrop" android:src="@drawable/ic_amber_note" android:padding="0dp"
        android:contentDescription="@null" />
    <ImageView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/amber_widget_shade" android:scaleType="fitXY" android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom"
        android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
        <LinearLayout android:id="@+id/amber_text"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical">
            <TextView android:id="@+id/amber_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="2" android:text="Amber Player"
                android:textColor="#FFFFFFFF" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/amber_artist"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text=""
                android:textColor="#FFF2A03D" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/amber_play"
            android:layout_width="44dp" android:layout_height="44dp" android:layout_marginStart="8dp"
            android:background="@drawable/amber_widget_play_bg" android:padding="10dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_amber_play" android:contentDescription="@string/amber_play" />
    </LinearLayout>
</FrameLayout>
