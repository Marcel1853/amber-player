<?xml version="1.0" encoding="utf-8"?>
<!-- Radio (4×2): laufender Sender oben, gespeicherte Sender darunter -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amber_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/amber_widget_bg" android:orientation="vertical" android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/amber_cover"
            android:layout_width="46dp" android:layout_height="46dp"
            android:background="@drawable/amber_widget_cover_bg" android:clipToOutline="true"
            android:scaleType="centerCrop" android:src="@drawable/ic_amber_radio" android:contentDescription="@null" />
        <LinearLayout android:id="@+id/amber_text"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="10dp" android:orientation="vertical">
            <TextView android:id="@+id/amber_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text="Radio"
                android:textColor="#FFF4EDE4" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/amber_artist"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text=""
                android:textColor="#FFF2A03D" android:textSize="12.5sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/amber_prev"
            android:layout_width="36dp" android:layout_height="36dp" android:background="@null"
            android:src="@drawable/ic_amber_prev" android:contentDescription="@string/amber_prev" />
        <ImageButton android:id="@+id/amber_play"
            android:layout_width="44dp" android:layout_height="44dp" android:layout_marginHorizontal="2dp"
            android:background="@drawable/amber_widget_play_bg" android:padding="10dp" android:scaleType="fitCenter"
            android:src="@drawable/ic_amber_play" android:contentDescription="@string/amber_play" />
        <ImageButton android:id="@+id/amber_next"
            android:layout_width="36dp" android:layout_height="36dp" android:background="@null"
            android:src="@drawable/ic_amber_next" android:contentDescription="@string/amber_next" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="8dp">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center_vertical"
            android:orientation="horizontal">
        <LinearLayout android:id="@+id/amber_st1_box"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:orientation="vertical" android:padding="2dp">
            <ImageView android:id="@+id/amber_st1"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/amber_widget_cover_bg" android:clipToOutline="true"
                android:scaleType="centerCrop" android:src="@drawable/ic_amber_radio" android:contentDescription="@null" />
            <TextView android:id="@+id/amber_st1_name"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text=""
                android:textColor="#CCF4EDE4" android:textSize="10.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/amber_st2_box"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:orientation="vertical" android:padding="2dp">
            <ImageView android:id="@+id/amber_st2"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/amber_widget_cover_bg" android:clipToOutline="true"
                android:scaleType="centerCrop" android:src="@drawable/ic_amber_radio" android:contentDescription="@null" />
            <TextView android:id="@+id/amber_st2_name"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text=""
                android:textColor="#CCF4EDE4" android:textSize="10.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/amber_st3_box"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:orientation="vertical" android:padding="2dp">
            <ImageView android:id="@+id/amber_st3"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/amber_widget_cover_bg" android:clipToOutline="true"
                android:scaleType="centerCrop" android:src="@drawable/ic_amber_radio" android:contentDescription="@null" />
            <TextView android:id="@+id/amber_st3_name"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text=""
                android:textColor="#CCF4EDE4" android:textSize="10.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/amber_st4_box"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:orientation="vertical" android:padding="2dp">
            <ImageView android:id="@+id/amber_st4"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/amber_widget_cover_bg" android:clipToOutline="true"
                android:scaleType="centerCrop" android:src="@drawable/ic_amber_radio" android:contentDescription="@null" />
            <TextView android:id="@+id/amber_st4_name"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text=""
                android:textColor="#CCF4EDE4" android:textSize="10.5sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/amber_st5_box"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_horizontal" android:orientation="vertical" android:padding="2dp">
            <ImageView android:id="@+id/amber_st5"
                android:layout_width="40dp" android:layout_height="40dp"
                android:background="@drawable/amber_widget_cover_bg" android:clipToOutline="true"
                android:scaleType="centerCrop" android:src="@drawable/ic_amber_radio" android:contentDescription="@null" />
            <TextView android:id="@+id/amber_st5_name"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:ellipsize="end" android:gravity="center" android:maxLines="1" android:text=""
                android:textColor="#CCF4EDE4" android:textSize="10.5sp" />
        </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/amber_stations_empty"
            android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:text="@string/amber_widget_radio_none" android:textColor="#99F4EDE4" android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
