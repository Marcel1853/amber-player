<?xml version="1.0" encoding="utf-8"?>
<!-- Groß (4×2): großes Cover, Titel, Interpret, Album und Steuerung -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/amber_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/amber_widget_bg" android:gravity="center_vertical"
    android:orientation="horizontal" android:padding="12dp">

    <ImageView android:id="@+id/amber_cover"
        android:layout_width="100dp" android:layout_height="100dp"
        android:background="@drawable/amber_widget_cover_bg" android:clipToOutline="true"
        android:scaleType="centerCrop" android:src="@drawable/ic_amber_note"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
        android:layout_marginStart="14dp" android:gravity="center_vertical" android:orientation="vertical">
        <LinearLayout android:id="@+id/amber_text"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/amber_title"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="2" android:text="Amber Player"
                android:textColor="#FFF4EDE4" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/amber_artist"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:ellipsize="end" android:maxLines="1" android:text=""
                android:textColor="#FFF2A03D" android:textSize="13.5sp" />
            <TextView android:id="@+id/amber_album"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:ellipsize="end" android:maxLines="1" android:text=""
                android:textColor="#99F4EDE4" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/amber_prev"
                android:layout_width="42dp" android:layout_height="42dp" android:background="@null"
                android:src="@drawable/ic_amber_prev" android:contentDescription="@string/amber_prev" />
            <ImageButton android:id="@+id/amber_play"
                android:layout_width="52dp" android:layout_height="52dp" android:layout_marginHorizontal="10dp"
                android:background="@drawable/amber_widget_play_bg" android:padding="13dp" android:scaleType="fitCenter"
                android:src="@drawable/ic_amber_play" android:contentDescription="@string/amber_play" />
            <ImageButton android:id="@+id/amber_next"
                android:layout_width="42dp" android:layout_height="42dp" android:background="@null"
                android:src="@drawable/ic_amber_next" android:contentDescription="@string/amber_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
