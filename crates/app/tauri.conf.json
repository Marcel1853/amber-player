{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amber Player",
  "version": "0.6.4",
  "identifier": "de.amberplayer.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Amber Player",
        "width": 1320,
        "height": 840,
        "minWidth": 940,
        "minHeight": 620,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Music",
    "publisher": "Amber Player",
    "shortDescription": "Moderner Musik-Player",
    "longDescription": "Musik-Player mit Bibliothek, Playlisten, Warteschlange, Effekt-Plugins (Equalizer, Crossfeed, Stereobreite, Limiter), HTTP-API für Stream Deck und eingebautem MCP-Server.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libasound2t64 | libasound2",
          "libdbus-1-3"
        ]
      },
      "rpm": {
        "depends": [
          "alsa-lib",
          "dbus-libs"
        ]
      }
    }
  },
  "mainBinaryName": "amber-player"
}
