{
  "id": "amber-overdrive",
  "name": "Amber Overdrive",
  "author": "Marcel1853",
  "description": "Rauer, übersteuerter Klang von Crunch bis Fuzz",
  "params": [
    {
      "id": "drive",
      "name": "Drive",
      "min": 0,
      "max": 100,
      "default": 35,
      "step": 5,
      "unit": "%"
    },
    {
      "id": "ton",
      "name": "Ton",
      "min": 0,
      "max": 100,
      "default": 50,
      "step": 5,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Crunch",
      "values": [
        35,
        50
      ]
    },
    {
      "name": "Fuzz",
      "values": [
        80,
        35
      ]
    },
    {
      "name": "Sanft",
      "values": [
        15,
        70
      ]
    }
  ],
  "chain": [
    {
      "type": "highpass",
      "freq": 70,
      "q": 0.7
    },
    {
      "type": "saturate",
      "drive": "1 + drive / 12"
    },
    {
      "type": "lowpass",
      "freq": "3000 + ton * 130",
      "q": 0.7
    },
    {
      "type": "gain",
      "db": "-drive / 12"
    }
  ]
}